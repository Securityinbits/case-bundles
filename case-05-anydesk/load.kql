// case-05-anydesk: load all 8 tables into a free Azure Data Explorer cluster in one paste.
// 1. Create a database (e.g. case05) in your free cluster: https://aka.ms/kustofree
// 2. Open the query editor on that database, paste this whole file, select all, Run.
// Re-running is safe: .set-or-replace replaces each table instead of appending duplicates.
// Then check row counts against mde/manifest.json:
//   union withsource=T * | summarize Rows=count() by T
.execute database script with (ThrowOnErrors=true) <|
// DeviceProcessEvents
.set-or-replace DeviceProcessEvents <|
